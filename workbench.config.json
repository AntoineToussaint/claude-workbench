{
  "colors": ["blue", "green", "red", "yellow", "black", "purple", "orange", "cyan"],
  "port": 3232,
  "multiplexer": "tmux",
  "launchers": [
    {
      "id": "iterm2",
      "label": "iTerm",
      "icon": "terminal",
      "type": "mux-terminal",
      "app": "/Applications/iTerm.app",
      "fullscreen": false,
      "panes": [
        { "cmd": "claude", "focus": true },
        { "cmd": null }
      ]
    },
    {
      "id": "zed",
      "label": "Zed",
      "icon": "editor",
      "type": "command",
      "cmd": "zed \"{{path}}\""
    },
    {
      "id": "vscode",
      "label": "VS Code",
      "icon": "editor",
      "type": "command",
      "cmd": "code \"{{path}}\""
    }
  ]
}
